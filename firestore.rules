rules_version = '2';
// Somente as contas da empresa listadas abaixo leem e gravam os dados do sistema.
// Para liberar outra conta, acrescente o e-mail (em minúsculas) na lista e publique as regras.
service cloud.firestore {
  match /databases/{database}/documents {
    function contaDaEmpresa() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'emoraesguilherme78@gmail.com'
        ];
    }
    match /{document=**} {
      allow read, write: if contaDaEmpresa();
    }
  }
}
